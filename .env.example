# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Cryptographic secret key used to sign session cookies and prevent tampering.
# Generate a secure 32+ byte hex or base64 string in production.
SESSION_SECRET="krushna_collection_secure_production_session_secret_key_9876543210"

# PORT: Server listening port (default: 3000)
PORT=3000

# NODE_ENV: Application environment (development or production)
NODE_ENV="development"
